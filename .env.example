# Copy this file to .env and fill in your own values.
# Get a free Gemini API key (no billing required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# ── API access control (all optional) ────────────────────────────────────────
# Comma-separated CORS origins. Defaults to http://localhost:3000.
# ALLOWED_ORIGINS=http://localhost:3000

# Leave unset to run open, which is right for a local demo. Set it for any
# deployment reachable beyond localhost: it gates DELETE/POST /reports and the
# LLM-backed endpoints (/chat, /copilot, /analyze_route_agents). The frontend
# must be built with the same value as NEXT_PUBLIC_API_TOKEN.
# API_TOKEN=

# Per-IP requests per minute for the LLM-backed endpoints. Default 20.
# LLM_RATE_LIMIT_PER_MINUTE=20
